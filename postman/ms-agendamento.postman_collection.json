    {
      "name": "03 - Fluxo positivo de agendamento",
      "item": [
        {
          "name": "Criar agendamento - Enfermeiro",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const janelaAleatoria = Math.floor(Math.random() * 60 * 60 * 1000);",
                  "const inicio = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000 + janelaAleatoria);",
                  "const fim = new Date(inicio.getTime() + 30 * 60 * 1000);",
                  "pm.collectionVariables.set('inicioCriacao', inicio.toISOString());",
                  "pm.collectionVariables.set('fimCriacao', fim.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cria agendamento', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Retorna identificador', function () { pm.expect(body.id).to.be.a('number'); });",
                  "pm.test('Retorna campos em português', function () { pm.expect(body).to.have.property('idPaciente'); pm.expect(body).to.have.property('idMedico'); pm.expect(body).to.have.property('dataHoraInicio'); pm.expect(body).to.have.property('dataHoraFim'); });",
                  "pm.collectionVariables.set('appointmentId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEnfermeiro}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPaciente\": {{idPacienteCadastro}},\n  \"idMedico\": 1,\n  \"dataHoraInicio\": \"{{inicioCriacao}}\",\n  \"dataHoraFim\": \"{{fimCriacao}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/agendamentos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "agendamentos"
              ]
            }
          }
        },
