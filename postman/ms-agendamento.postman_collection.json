        {
          "name": "Atualizar agendamento do avaliador - Médico",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const janelaAleatoria = Math.floor(Math.random() * 60 * 60 * 1000);",
                  "const inicio = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000 + janelaAleatoria);",
                  "const fim = new Date(inicio.getTime() + 30 * 60 * 1000);",
                  "pm.collectionVariables.set('inicioAtualizacao', inicio.toISOString());",
                  "pm.collectionVariables.set('fimAtualizacao', fim.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Atualiza agendamento do avaliador', function () { pm.response.to.have.status(200); });",
                  "pm.test('Mantém identificador e paciente do avaliador', function () { const body = pm.response.json(); pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('appointmentId'))); pm.expect(body.idPaciente).to.eql(Number(pm.collectionVariables.get('idPacienteCadastro'))); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenMedico}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPaciente\": {{idPacienteCadastro}},\n  \"idMedico\": 1,\n  \"dataHoraInicio\": \"{{inicioAtualizacao}}\",\n  \"dataHoraFim\": \"{{fimAtualizacao}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/agendamentos/{{appointmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "agendamentos",
                "{{appointmentId}}"
              ]
            }
          }
        }
      ]
    },
