      "item": [
        {
          "name": "Cadastrar paciente do avaliador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{cadastroUsername}}\",\n  \"password\": \"{{cadastroPassword}}\",\n  \"nome\": \"{{cadastroNome}}\",\n  \"email\": \"{{cadastroEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "registro"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cadastra paciente', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('Retorna dados públicos do paciente', function () { pm.expect(body.id).to.be.a('number'); pm.expect(body.username).to.eql(pm.collectionVariables.get('cadastroUsername')); pm.expect(body.email).to.eql(pm.collectionVariables.get('cadastroEmail')); });",
                  "pm.collectionVariables.set('idPacienteCadastro', body.id);"
                ]
              }
            }
          ]
        },
