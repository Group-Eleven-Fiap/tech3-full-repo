    {
      "name": "05 - GraphQL",
      "item": [
        {
          "name": "Consultar histórico futuro do paciente avaliador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenPaciente}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"query HistoricoPaciente($patientId: ID!, $futureOnly: Boolean!) { historicoPaciente(patientId: $patientId, futureOnly: $futureOnly) { id patientId professionalId scheduledAt endsAt createdAt updatedAt } }\",\n  \"variables\": {\n    \"patientId\": \"{{idPacienteCadastro}}\",\n    \"futureOnly\": true\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "graphql"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consulta GraphQL com sucesso', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Não retorna erros GraphQL', function () { pm.expect(body.errors).to.not.exist; });",
                  "pm.test('Retorna histórico do paciente avaliador', function () { const consultas = body.data.historicoPaciente; pm.expect(consultas).to.be.an('array').and.not.empty; consultas.forEach(function (consulta) { pm.expect(String(consulta.patientId)).to.eql(String(pm.collectionVariables.get('idPacienteCadastro'))); }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar histórico sem autenticação (negativo)",
