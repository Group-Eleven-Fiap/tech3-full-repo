COMPOSE_PROJECT_NAME=ms-agendamento-notificacao

# PostgreSQL usado pelo ms-agendamento
DB_HOST=postgres
DB_PORT=5432
DB_NAME=agendamento
DB_USERNAME=agendamento
DB_PASSWORD=change-me

# RabbitMQ compartilhado pelos dois serviços
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=agendamento
RABBITMQ_PASSWORD=change-me

# Segurança da API de agendamento
APP_JWT_SECRET=change-this-demo-secret-to-a-long-random-value-32
APP_JWT_EXPIRATION_SECONDS=3600

# Portas expostas no host; os dois serviços continuam usando 8080 internamente
AGENDAMENTO_API_PORT=8080
NOTIFICACAO_API_PORT=8081

# Configuração Gmail SMTP do ms-notificacao (preencher somente no ambiente local)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=fiap0674@gmail.com
SPRING_MAIL_PASSWORD=qtwopvuwrieaflvm
SPRING_MAIL_DEBUG=false

# Retry do processamento de notificações
NOTIFICACAO_RETRY_MAX_ATTEMPTS=3
NOTIFICACAO_RETRY_DELAY_MS=1000
NOTIFICACAO_RETRY_MULTIPLIER=2